{
  "manifest_version": 3,
  "name": "Stash",
  "version": "1.0.0",
  "key": "",
  "description": "Stash URLs, text snippets, and more to your personal knowledge vault.",
  "permissions": [
    "activeTab",
    "contextMenus",
    "scripting",
    "storage",
    "nativeMessaging",
    "tabs"
  ],
  "host_permissions": ["<all_urls>"],
  "web_accessible_resources": [
    {
      "resources": [
        "picker.html", "picker.js", "picker.css",
        "snippet.html", "snippet.js", "snippet.css"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "omnibox": {
    "keyword": "stash"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
